{
  "name": "vibrational-state",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "aws-cognito-template",
    "packages/*",
    "apps/*",
    "infra/*"
  ],
  "scripts": {
    "vs": "npm run start --workspace vs-helper",
    "vs:dev": "npm run start:dev --workspace vs-helper",
    "vs:dev:tunnel": "npm run start:dev:tunnel --workspace vs-helper",
    "vs:tunnel": "npm run start:tunnel --workspace vs-helper",
    "vs:backend:synth": "npm run synth --workspace vs-helper-backend",
    "vs:backend:deploy": "npm run deploy --workspace vs-helper-backend",
    "type-check": "npm run type-check --workspaces --if-present"
  },
  "devDependencies": {
    "expo-asset": "12.0.13"
  },
  "overrides": {
    "react-dom": "19.1.0"
  }
}
